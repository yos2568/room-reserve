msgid "Full name"
msgstr "ชื่อ-นามสกุล"

#: core/templates/core/register.html:29
#, python-format
msgid "Must end with %(domain)s"
msgstr "ต้องลงท้ายด้วย %(domain)s"

#: core/templates/core/register.html:32
msgid "Your instrument"
msgstr "เครื่องดนตรีที่เล่น"

#: core/templates/core/register.html:34
