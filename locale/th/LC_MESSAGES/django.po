msgid "Save override"
msgstr "บันทึกการกำหนด"

#: core/templates/core/staff/calendar.html:37
msgid "Existing overrides"
msgstr "รายการที่กำหนดไว้"

#: core/templates/core/staff/calendar.html:43
msgid "None yet."
msgstr "ยังไม่มี"

#: core/templates/core/staff/closures.html:8
msgid "Preview affected sessions"
msgstr "ดูตัวอย่างรายการที่ได้รับผลกระทบ"

#: core/templates/core/staff/closures.html:9
msgid ""
"Nothing is changed by a preview. Confirming rechecks the same range under "
