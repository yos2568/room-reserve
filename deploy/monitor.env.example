# Copy outside the repository, for example to /root/roomreserve-monitor.env,
# chmod 600, and set the public URL and optional alert destination.
COMPOSE_FILE=/root/roomreserve/compose.hostinger.yaml
ENV_FILE=/root/roomreserve/.env
ROOMRESERVE_BASE_URL=https://roomreserve.yos.in.th
BACKUP_DIR=/var/backups/roomreserve
BACKUP_MAX_AGE_SECONDS=86400
DISK_WARN_PERCENT=85
ALERT_WEBHOOK_URL=
