# Copy outside the repository, for example to /root/roomreserve-backup.env,
# chmod 600, and fill the recipient and dedicated remote before enabling the timer.
COMPOSE_FILE=/root/roomreserve/compose.hostinger.yaml
ENV_FILE=/root/roomreserve/.env
BACKUP_DIR=/var/backups/roomreserve
BACKUP_REMOTE=your-rclone-remote:roomreserve-production
BACKUP_AGE_RECIPIENT=age1replace-with-the-public-recipient
RETENTION_DAYS=30
