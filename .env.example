# Room Reserve — example environment file.
# Copy to .env and fill in. NEVER commit the real .env; it is gitignored.
# No real secret belongs in this file.

# --- Django -------------------------------------------------------------------
DJANGO_SETTINGS_MODULE=roomreserve.settings.dev
DJANGO_SECRET_KEY=change-me-generate-a-long-random-value
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8000
DJANGO_LOG_LEVEL=INFO
DJANGO_CONN_MAX_AGE=0

# The test clock is development/test infrastructure only. It is never exposed by
# a public endpoint and MUST stay false in production.
ALLOW_TEST_CLOCK=false

# --- PostgreSQL ---------------------------------------------------------------
POSTGRES_DB=roomreserve
POSTGRES_USER=roomreserve
POSTGRES_PASSWORD=roomreserve
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# --- Email --------------------------------------------------------------------
# Development default is the Mailpit catcher started by compose.override.yaml
# (SMTP 1025, web inbox <http://localhost:8025>). Production must supply a real
# relay; the production settings module refuses to start without it.
EMAIL_HOST=localhost
EMAIL_PORT=1025
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=false
DEFAULT_FROM_EMAIL=roomreserve@localhost.test
OUTBOX_ENABLED=true

# --- Operational policy defaults ---------------------------------------------
# Application policy choices, not requirements of the source regulation; they
# require faculty endorsement before launch (V3 sections 1 and 7).
POLICY_HORIZON_DAYS=7
POLICY_DAILY_QUOTA=2
POLICY_CHECKIN_GRACE_MINUTES=15
POLICY_STRIKE_WINDOW_DAYS=30
POLICY_STRIKE_THRESHOLD=3
POLICY_AUTO_SUSPENSION_DAYS=7
POLICY_REMINDER_LEAD_MINUTES=30

# --- Institution details ------------------------------------------------------
INSTITUTION_EMAIL_DOMAIN=student.chula.ac.th
SUPPORT_CONTACT_NAME=คุณสิตานันท์ (พี่ดิว)
SUPPORT_CONTACT_PHONE=02-218-4604
SUPPORT_CONTACT_EMAIL=Sitanun.S@chula.ac.th

# --- Image tag ----------------------------------------------------------------
APP_TAG=local
