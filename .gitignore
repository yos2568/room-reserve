# graft's local graph cache — regenerable, not committed (run `graft build`).
/graft/

# --- Room Reserve application ---
# Secrets and local environment overrides. .env.example IS committed.
.env
.env.*
!.env.example

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/

# Test/QA evidence is regenerated by scripts/verify and never committed.
/artifacts/qa/

# STATIC_ROOT: `collectstatic` output, regenerated at image build time.
/staticfiles/

# Locally compiled Tailwind output is committed; node_modules is not.
/node_modules/

# Presentation build caches (regenerable).
/.presentation-build/
/.chart-data-*/
.DS_Store
._*
